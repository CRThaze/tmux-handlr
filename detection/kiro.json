{
 "aliases": [
  "kiro-cli"
 ],
 "id": "kiro",
 "min_engine_version": 2,
 "rules": [
  {
   "id": "live_prompt_idle",
   "line_regex": [
    "(?i)^\\s*[>›]\\s*ask a question or describe a task(?:\\s+(?:enter|↵))?\\s*$"
   ],
   "priority": 1100,
   "region": "bottom_non_empty_lines(4)",
   "state": "idle",
   "visible_idle": true
  },
  {
   "any": [
    {
     "all": [
      {
       "regex": [
        "(?is)(?:^|\\n)\\s*esc\\s+to\\s+close\\b(?:[^\\n]*\\bto\\s+navigate\\b[^\\n]*|.*\\bto\\s+navigate\\b.*\\bto\\s+select\\b.*\\btab\\s+to\\s+edit|[^\\n]*\\benter\\s+to\\s+see\\s+more\\s+options)\\s*\\z"
       ]
      },
      {
       "any": [
        {
         "line_regex": [
          "(?i)^\\s*[>❯]\\s*(?:allow|always allow|deny|always deny)\\s*$",
          "(?i)^\\s*(?:[>❯]\\s*)?allow\\s*$",
          "(?i)^\\s*(?:[>❯]\\s*)?always allow\\s*$",
          "(?i)^\\s*(?:[>❯]\\s*)?deny\\s*$",
          "(?i)^\\s*(?:[>❯]\\s*)?always deny\\s*$"
         ]
        },
        {
         "line_regex": [
          "(?i)^\\s*[>❯]\\s*(?:yes, single permission|trust, always allow in this session|no \\(tab to edit\\))\\s*$",
          "(?i)^\\s*(?:[>❯]\\s*)?yes, single permission\\s*$",
          "(?i)^\\s*(?:[>❯]\\s*)?trust, always allow in this session\\s*$",
          "(?i)^\\s*(?:[>❯]\\s*)?no \\(tab to edit\\)\\s*$"
         ]
        },
        {
         "line_regex": [
          "(?i)^\\s*[>❯]\\s*(?:trust\\b.*|entire tool)\\s*$",
          "(?i)^\\s*(?:[>❯]\\s*)?(?:trust )?entire tool(?:\\s+\\([^\\n]*\\))?(?:\\s+(?:session|workspace|always))?\\s*$"
         ]
        }
       ]
      }
     ]
    }
   ],
   "id": "tool_approval",
   "priority": 1050,
   "region": "bottom_non_empty_lines(8)",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "id": "tool_approval_edit",
   "priority": 1045,
   "regex": [
    "(?im)(?:^|\\n)[ \\t]*[-─]+[ \\t]*\\n[^\\n]*requires\\s+approval\\s*[·.]\\s*modify\\s+request[ \\t]*\\n(?:[ \\t]*\\n|[^\\n]*[^\\s─-][^\\n]*\\n)*?[ \\t]*[>›][ \\t]*[^\\n]*\\n(?:[ \\t]*\\n|[^\\n]*[^\\s─-][^\\n]*\\n)*[ \\t]*[-─]+[ \\t]*\\n[ \\t]*esc[ \\t]+to[ \\t]+close[ \\t]*\\n?\\z"
   ],
   "region": "whole_recent",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "contains": [
    "tool approval",
    "approve all pending",
    "configure individually (agent monitor)",
    "exit (cancel subagents)"
   ],
   "id": "crew_approval",
   "priority": 1040,
   "region": "bottom_non_empty_lines(8)",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "contains": [
    "to navigate",
    "to submit",
    "esc to cancel"
   ],
   "id": "question_panel",
   "priority": 1030,
   "region": "bottom_non_empty_lines(8)",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "contains": [
    "kiro is working",
    "type to steer",
    "ctrl+s to queue"
   ],
   "id": "live_working_footer",
   "priority": 950,
