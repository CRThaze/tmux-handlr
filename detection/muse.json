{
 "aliases": [
  "muse-code",
  "muse-cli"
 ],
 "id": "muse",
 "min_engine_version": 2,
 "rules": [
  {
   "any": [
    {
     "contains": [
      "Trust and continue"
     ]
    },
    {
     "contains": [
      "Use Up/Down"
     ]
    }
   ],
   "contains": [
    "Do you trust this workspace?"
   ],
   "id": "workspace_trust_blocked",
   "priority": 970,
   "region": "bottom_non_empty_lines(12)",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "any": [
    {
     "contains": [
      "Enter to select",
      "Tab for an optional note"
     ]
    },
    {
     "contains": [
      "Enter to toggle",
      "Esc to interrupt"
     ]
    }
   ],
   "id": "pick_request_blocked",
   "priority": 950,
   "region": "bottom_non_empty_lines(8)",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "any": [
    {
     "contains": [
      "enter confirm",
      "esc go back"
     ]
    },
    {
     "contains": [
      "enter save",
      "esc go back"
     ]
    },
    {
     "contains": [
      "space toggle",
      "esc close",
      "type filter"
     ]
    }
   ],
   "id": "menu_overlay",
   "priority": 940,
   "region": "bottom_non_empty_lines(8)",
   "skip_state_update": true,
   "state": "unknown"
  },
  {
   "contains": [
    "esc to interrupt"
   ],
   "id": "working_esc_interrupt",
   "not": [
    {
     "contains": [
      "Enter to select",
      "Tab for an optional note"
     ]
    },
    {
     "contains": [
      "Enter to toggle",
      "Esc to interrupt"
     ]
    }
   ],
   "priority": 900,
   "region": "bottom_non_empty_lines(8)",
   "state": "working",
   "visible_working": true
  },
  {
   "any": [
    {
     "contains": [
      "Allow this stage once",
      "Always allow in this workspace"
     ]
    },
    {
     "contains": [
      "Allow once",
      "Allow for this session"
     ]
    },
    {
     "contains": [
      "Yes, proceed",
      "Yes, don't ask again this session"
     ]
    }
   ],
   "id": "blocked_approval",
   "priority": 850,
   "region": "bottom_non_empty_lines(8)",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "any": [
    {
     "line_regex": [
      "^\\s*⟩\\s*$"
     ]
    },
    {
     "line_regex": [
      "^\\s*⟩\\s+\\S"
     ]
    }
   ],
   "id": "idle_prompt",
   "not": [
    {
     "contains": [
      "esc to interrupt"
     ]
    },
    {
     "contains": [
      "Enter to select",
      "Tab for an optional note"
     ]
    },
    {
     "contains": [
      "Enter to toggle",
      "Esc to interrupt"
     ]
    },
    {
     "contains": [
      "enter confirm",
      "esc go back"
     ]
    },
    {
     "contains": [
      "enter save",
      "esc go back"
     ]
    },
    {
     "contains": [
      "space toggle",
      "esc close",
      "type filter"
     ]
    }
   ],
   "priority": 700,
   "region": "bottom_non_empty_lines(5)",
   "state": "idle",
   "visible_idle": true
  },
  {
   "id": "idle_status_fallback",
   "line_regex": [
    "^\\s*\\S+ · (none|minimal|low|medium|high|xhigh|ultra) · "
   ],
   "not": [
    {
     "contains": [
      "esc to interrupt"
     ]
    }
   ],
   "priority": 500,
   "region": "bottom_non_empty_lines(3)",
   "state": "idle",
   "visible_idle": true
  }
 ],
 "updated_at": "2026-08-26T00:00:00Z",
 "version": "2026.08.26.1"
}