{
 "aliases": [
  "letta-code",
  "letta code"
 ],
 "id": "letta",
 "min_engine_version": 3,
 "rules": [
  {
   "id": "osc_progress_blocked",
   "priority": 1400,
   "regex": [
    "^4;3(?:;|$)"
   ],
   "region": "osc_progress",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "id": "osc_title_blocked",
   "priority": 1300,
   "regex": [
    "^\\[ [!.] \\] Action Required(?: \\| |$)"
   ],
   "region": "osc_title",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "contains": [
    "Run this command?",
    "Enter to select · Esc to cancel"
   ],
   "id": "command_approval",
   "priority": 1200,
   "region": "bottom_non_empty_lines(20)",
   "state": "blocked",
   "visible_blocker": true
  },
  {
   "id": "osc_title_working",
   "priority": 900,
   "regex": [
    "(?:^| )[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏](?: |$)"
   ],
   "region": "osc_title",
   "state": "working",
   "visible_working": true
  },
  {
   "id": "active_status",
   "line_regex": [
    "^\\s*(?:\\S+\\s+)+is(?: \\S+)*… \\((?:esc to interrupt(?: · .*)?|interrupting)\\)\\s*$"
   ],
   "priority": 850,
   "region": "bottom_non_empty_lines(8)",
   "state": "working",
   "visible_working": true
  },
  {
   "id": "running_tool",
   "line_regex": [
    "^\\s*(?:└\\s*)?Running\\.\\.\\.\\s*(?:\\(.*\\))?$"
   ],
   "priority": 800,
   "region": "bottom_non_empty_lines(8)",
   "state": "working",
   "visible_working": true
  },
  {
   "contains": [
    "Create a new agent (--new)",
    "Enter select · Esc exit"
   ],
   "id": "profile_selector",
   "priority": 700,
   "region": "bottom_non_empty_lines(12)",
   "state": "unknown"
  },
  {
   "id": "composer_input",
   "line_regex": [
    "^\\s*›\\s+\\S.*$"
   ],
   "not": [
    {
     "line_regex": [
      "^\\s*›\\s+Try\\s+\""
     ]
    }
   ],
   "priority": 150,
   "region": "bottom_non_empty_lines(8)",
   "state": "unknown"
  },
  {
   "any": [
    {
     "line_regex": [
      "^\\s*›\\s*$"
     ]
    },
    {
     "line_regex": [
      "^\\s*›\\s+Try\\s+\""
     ]
    }
   ],
   "id": "composer_idle",
   "not": [
    {
     "line_regex": [
      "^\\s*(?:\\S+\\s+)+is(?: \\S+)*… \\((?:esc to interrupt(?: · .*)?|interrupting)\\)\\s*$"
     ]
    },
    {
     "line_regex": [
      "^\\s*(?:└\\s*)?Running\\.\\.\\.\\s*(?:\\(.*\\))?$"
     ]
    }
   ],
   "priority": 100,
   "region": "bottom_non_empty_lines(8)",
   "state": "idle",
   "visible_idle": true
  },
  {
   "id": "no_live_state_evidence",
   "priority": 0,
   "regex": [
    "(?s)^.*$"
   ],
   "region": "whole_recent",
   "state": "unknown"
  }
 ],
 "updated_at": "2026-08-24T00:00:00Z",
 "version": "2026.08.24.1"
}